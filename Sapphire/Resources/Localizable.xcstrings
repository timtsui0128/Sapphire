        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically lock and unlock your Mac using a trusted Bluetooth device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用可信蓝牙设备自动锁定和解锁 Mac。"
          }
        }
      }
    },
    "Automatically matches the orientation reported by the camera. If an external camera feed appears rotated, choose a fixed angle to display it upright.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically matches the orientation reported by the camera. If an external camera feed appears rotated, choose a fixed angle to display it upright."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动匹配摄像头报告的方向。外接摄像头画面倾斜时，可选择固定角度以保持正向。"
          }
        }
      }
    },
    "Automatically pause now playing media and resume when the lid opens back up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pause now playing media and resume when the lid opens back up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖时自动暂停媒体，重新开盖后恢复播放。"
          }
        }
      }
    },
    "Automatically pauses charging if the battery temperature gets too high to prevent heat-related damage and extend its lifespan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pauses charging if the battery temperature gets too high to prevent heat-related damage and extend its lifespan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池温度过高时自动暂停充电，以减少热损伤并延长寿命。"
          }
        }
      }
    },
    "Automatically pauses music or videos when the screen locks.": {
      "extractionState": "manual",
