          "stringUnit": {
            "state": "translated",
            "value": "拖到顶部时显示 AirDrop 和剪贴板"
          }
        }
      }
    },
    "Drag files to the top to choose AirDrop or Copy to Clipboard. Drop on AirDrop to choose a device; drop on Clipboard to paste the files later with Command-V. Turn this off to show the usual file destinations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag files to the top to choose AirDrop or Copy to Clipboard. Drop on AirDrop to choose a device; drop on Clipboard to paste the files later with Command-V. Turn this off to show the usual file destinations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖到顶部，即可选择 AirDrop 或复制到剪贴板。放到 AirDrop 区域后选择接收设备；放到剪贴板区域后可按 Command-V 粘贴文件。关闭此选项可显示原有文件投放区域。"
          }
        }
      }
    }
