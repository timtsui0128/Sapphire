          "stringUnit": {
            "state": "translated",
            "value": "即使 TopLet 判断刘海空间不足，也允许启用任意小组件。"
          }
        }
      }
    },
    "App version details, TopLet updates, release channels, credits, links, and project information.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
