        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问 TopLet"
          }
        }
      }
    },
    "Ask about any setting, get suggestions, or have TopLet change things for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about any setting, get suggestions, or have TopLet change things for you."
          }
