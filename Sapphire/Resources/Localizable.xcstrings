          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“匹配壁纸”根据壁纸顶部调整外接屏细条和展开的液态玻璃面板。动态壁纸等背景不匹配时，可指定浅色或深色玻璃。收集截图后仍保留闲置细条入口。"
