          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下任一条件满足时自动保持唤醒，均不满足时关闭。手动关闭会暂停自动规则，直到该条件结束。"
          }
        }
      }
    },
