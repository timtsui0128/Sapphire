    "Create a profile, add reveal conditions, and optionally bind it to a display, a Space, or a Focus filter. When a bound context is active and any condition is met, hidden items are revealed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a profile, add reveal conditions, and optionally bind it to a display, a Space, or a Focus filter. When a bound context is active and any condition is met, hidden items are revealed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建配置并添加显示条件，可绑定到显示器、空间或专注过滤条件。绑定环境生效且任一条件满足时，显示隐藏项目。"
          }
        }
      }
    },
    "Create an app at developer.tidal.com, enable the user.read, search.read, collection.read/write, and playlists.read/write scopes, and set the redirect URI exactly to sapphire://callback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an app at developer.tidal.com, enable the user.read, search.read, collection.read/write, and playlists.read/write scopes, and set the redirect URI exactly to sapphire://callback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 developer.tidal.com 创建应用，启用 user.read、search.read、collection.read/write 和 playlists.read/write 权限，并将重定向 URI 精确设为 sapphire://callback。"
          }
        }
      }
    },
    "Create it in Shopify Admin → Settings → Apps and sales channels → Develop apps, with read_orders permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
