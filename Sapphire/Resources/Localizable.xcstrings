    "Prevent hover, click, and swipe from expanding the notch while the Mac is locked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent hover, click, and swipe from expanding the notch while the Mac is locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 锁屏时，阻止通过悬停、点击或滑动展开刘海。"
          }
        }
      }
    },
    "Prevent locked apps from opening until authenticated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent locked apps from opening until authenticated"
          }
