          }
        }
      }
    },
    "Applies gain to TopLet's live level meter so you can check clipping. Other apps still receive the original microphone signal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies gain to TopLet's live level meter so you can check clipping. Other apps still receive the original microphone signal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 TopLet 实时电平表增加增益，便于检查削波。其他应用仍接收原始麦克风信号。"
          }
        }
      }
    },
    "Ask TopLet": {
      "extractionState": "manual",
      "localizations": {
