          }
        }
      }
    },
    "Notify you when a verified TopLet release is ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify you when a verified TopLet release is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证的 TopLet 新版本就绪时通知。"
          }
        }
      }
    },
    "Open TopLet Setting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TopLet Setting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 TopLet 设置"
          }
        }
      }
    },
    "Open the unified TopLet picker right where you're typing with a global shortcut. Selecting a clipboard item copies it and pastes it at the cursor; the Emoji tab types emoji directly. (The emoji shortcut opens the same panel on its Emoji tab.)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the unified TopLet picker right where you're typing with a global shortcut. Selecting a clipboard item copies it and pastes it at the cursor; the Emoji tab types emoji directly. (The emoji shortcut opens the same panel on its Emoji tab.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用全局快捷键，在输入位置打开 TopLet 统一选择器。选择剪贴板项目后会复制并粘贴到光标处；表情标签页可直接输入表情符号。表情快捷键也会打开同一面板的表情标签页。"
          }
        }
      }
    },
    "Please log in to Spotify via the Music section in TopLet's settings to use this feature.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please log in to Spotify via the Music section in TopLet's settings to use this feature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 TopLet 设置的“音乐”页面登录 Spotify，再使用此功能。"
          }
        }
      }
    },
    "Quit TopLet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit TopLet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 TopLet"
          }
        }
      }
    },
    "Reference page listing every keyboard shortcut in TopLet — global hotkeys, snap zones, and in-app shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference page listing every keyboard shortcut in TopLet — global hotkeys, snap zones, and in-app shortcuts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出 TopLet 全部键盘快捷键，包括全局快捷键、窗口布局和应用内快捷键。"
          }
        }
      }
    },
    "Relaunch TopLet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaunch TopLet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 TopLet"
          }
        }
      }
    },
    "Remove the selected screenshots from TopLet storage. Originals of manually added files are kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the selected screenshots from TopLet storage. Originals of manually added files are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 TopLet 存储中移除选中的截图。手动添加文件的原件会保留。"
          }
        }
      }
    },
    "Requires administrator access; TopLet cannot remove this item": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires administrator access; TopLet cannot remove this item"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要管理员权限，TopLet 无法移除此项目"
          }
        }
      }
    },
    "Restore all TopLet preferences to their defaults.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore all TopLet preferences to their defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有 TopLet 偏好恢复为默认值。"
          }
        }
      }
    },
    "TopLet Archives": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet Archives"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 归档"
          }
        }
      }
    },
    "TopLet Onboarding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet Onboarding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 初始设置"
          }
        }
      }
    },
    "TopLet Timers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet Timers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 计时器"
          }
        }
      }
    },
    "TopLet automatically uses Apple's standard Clock shortcut names (\"Start Timer\", \"Start Stopwatch\", etc.). If iCloud sync is enabled and those Clock shortcuts are present on this Mac, they run automatically during sessions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet automatically uses Apple's standard Clock shortcut names (\"Start Timer\", \"Start Stopwatch\", etc.). If iCloud sync is enabled and those Clock shortcuts are present on this Mac, they run automatically during sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 自动使用 Apple 标准时钟快捷指令名称，如“Start Timer”和“Start Stopwatch”。若已启用 iCloud 同步且本机有这些指令，专注期间会自动运行。"
          }
        }
      }
    },
    "TopLet hides items with macOS's own menu bar controls only when it is installed in the Applications folder. This copy runs from elsewhere, so it falls back to stretching the divider up to the app menus.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet hides items with macOS's own menu bar controls only when it is installed in the Applications folder. This copy runs from elsewhere, so it falls back to stretching the divider up to the app menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在安装到应用程序文件夹时，TopLet 才使用 macOS 自带菜单栏控制隐藏项目。当前从其他位置运行，因此改用延伸分隔区的方式隐藏。"
          }
        }
      }
    },
    "TopLet hides its windows, notch, widgets, and overlays on the lock screen. Its interface cannot be opened or interacted with until you unlock your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet hides its windows, notch, widgets, and overlays on the lock screen. Its interface cannot be opened or interacted with until you unlock your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏时，TopLet 会隐藏窗口、刘海、小组件和浮层。解锁 Mac 前无法打开或操作其界面。"
          }
        }
      }
    },
    "TopLet is a Connect controller only, audio always plays on the Spotify desktop app or another speaker.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet is a Connect controller only, audio always plays on the Spotify desktop app or another speaker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 仅作为 Connect 控制器，音频始终在 Spotify 桌面应用或其他扬声器上播放。"
          }
        }
      }
    },
    "TopLet needs a few permissions for its core features.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet needs a few permissions for its core features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 的核心功能需要几项权限。"
          }
        }
      }
    },
    "TopLet needs a privileged helper for battery management and system integrations. macOS will ask you to allow it under Login Items → Background Activity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet needs a privileged helper for battery management and system integrations. macOS will ask you to allow it under Login Items → Background Activity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池管理与系统集成需要特权辅助服务。macOS 会要求你在“登录项 → 后台活动”中允许它。"
          }
        }
      }
    },
    "TopLet never permanently deletes Trash contents; review and empty Trash in Finder when ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet never permanently deletes Trash contents; review and empty Trash in Finder when ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 不会永久删除废纸篓内容，请在访达中检查后自行清空"
          }
        }
      }
    },
    "TopLet stays hidden and unavailable while your Mac is locked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet stays hidden and unavailable while your Mac is locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 锁屏时，TopLet 保持隐藏且不可操作。"
          }
        }
      }
    },
    "TopLet uses MusicKit for Apple Music artwork, artist details, the queue and your library. No login is needed beyond Apple Music access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet uses MusicKit for Apple Music artwork, artist details, the queue and your library. No login is needed beyond Apple Music access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 通过 MusicKit 读取 Apple Music 封面、艺人信息、队列和资料库。授予 Apple Music 权限后无需额外登录。"
          }
        }
      }
    },
    "TopLet watches your own processes — nothing is read from inside an app, no accessibility permission is used, and nothing leaves the Mac.\n\nTools that only exist while they run (xcodebuild, cargo, gradle, npm run build, a command you typed) are detected the moment they start. Tools that stay resident between turns (Claude, Codex, an editor's built-in agent, a Gradle daemon) are reported only while they are actually working, which is why sensitivity exists.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet watches your own processes — nothing is read from inside an app, no accessibility permission is used, and nothing leaves the Mac.\n\nTools that only exist while they run (xcodebuild, cargo, gradle, npm run build, a command you typed) are detected the moment they start. Tools that stay resident between turns (Claude, Codex, an editor's built-in agent, a Gradle daemon) are reported only while they are actually working, which is why sensitivity exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 仅监测本机进程，不读取应用内部内容、不使用辅助功能权限，也不向外发送数据。\n\n仅在运行时存在的工具（如 xcodebuild、cargo、gradle、npm run build 或你输入的命令）会在启动时被检测。常驻工具（如 Claude、Codex、编辑器内置智能体或 Gradle 守护进程）仅在实际工作时报告，因此提供了灵敏度选项。"
          }
        }
      }
    },
    "TopLet's menu bar icons need TopLet to be allowed under System Settings → Menu Bar → Allow in the Menu Bar. If the control item never appears, check that switch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet's menu bar icons need TopLet to be allowed under System Settings → Menu Bar → Allow in the Menu Bar. If the control item never appears, check that switch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 菜单栏图标需要在“系统设置 → 菜单栏 → 允许在菜单栏中显示”中获得允许。控制项目始终不出现时，请检查该开关。"
          }
        }
      }
    },
    "Save a portable copy of your TopLet preferences or restore one you exported earlier.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a portable copy of your TopLet preferences or restore one you exported earlier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存可迁移的 TopLet 偏好副本，或恢复之前导出的备份。"
          }
        }
      }
    },
    "Send anonymous usage events to Google to help improve TopLet. Disable this to opt out of analytics collection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send anonymous usage events to Google to help improve TopLet. Disable this to opt out of analytics collection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Google 发送匿名使用事件以改进 TopLet。关闭后退出分析数据收集。"
          }
        }
      }
    },
    "Set RPM at each temperature. TopLet interpolates between points.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set RPM at each temperature. TopLet interpolates between points."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置各温度下的转速，TopLet 会在控制点之间插值。"
          }
        }
      }
    },
    "Share anonymous usage data with Google Analytics to help improve TopLet. You can change this anytime in Settings > General.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share anonymous usage data with Google Analytics to help improve TopLet. You can change this anytime in Settings > General."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Google Analytics 分享匿名使用数据以改进 TopLet，可随时在“设置 → 通用”中更改。"
          }
        }
      }
    },
    "Show TopLet folder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show TopLet folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 TopLet 文件夹"
          }
        }
      }
    },
    "Show TopLet storage folder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show TopLet storage folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 TopLet 存储文件夹"
          }
        }
      }
    },
    "Show TopLet's notch and features when your Mac is locked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show TopLet's notch and features when your Mac is locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 锁屏时显示 TopLet 刘海与功能。"
          }
        }
      }
    },
    "Show an alert in the notch when a new TopLet version is available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show an alert in the notch when a new TopLet version is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 TopLet 新版本时，在刘海中显示提醒。"
          }
        }
      }
    },
    "Show your own image or video behind the clock, sign-in controls, and TopLet widgets on the lock screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your own image or video behind the clock, sign-in controls, and TopLet widgets on the lock screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁屏时钟、登录控件与 TopLet 小组件后显示自定义图片或视频。"
          }
        }
      }
    },
    "Show “Hold ⌘Q to quit” or “Press ⌘Q again” on screen while TopLet waits for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show “Hold ⌘Q to quit” or “Press ⌘Q again” on screen while TopLet waits for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待确认时，在屏幕上显示“长按 ⌘Q 退出”或“再次按 ⌘Q”。"
          }
        }
      }
    },
    "Skips the macOS floating thumbnail while collection is enabled. TopLet collects the image as soon as the saved file is complete. Your previous thumbnail setting is restored when collection stops or TopLet quits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips the macOS floating thumbnail while collection is enabled. TopLet collects the image as soon as the saved file is complete. Your previous thumbnail setting is restored when collection stops or TopLet quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启收集时跳过 macOS 浮动缩略图，文件完整保存后立即收集。停止收集或退出 TopLet 时，会恢复原来的缩略图设置。"
          }
        }
      }
    },
    "Start TopLet automatically when you log in to your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start TopLet automatically when you log in to your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Mac 时自动启动 TopLet。"
          }
        }
      }
    },
    "Start TopLet automatically with your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start TopLet automatically with your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随 Mac 自动启动 TopLet。"
          }
        }
      }
    },
    "Take a screenshot with ⇧⌘4 or ⇧⌘3 and let it save.\nTopLet moves it here, ready to select and drag together.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a screenshot with ⇧⌘4 or ⇧⌘3 and let it save.\nTopLet moves it here, ready to select and drag together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ⇧⌘4 或 ⇧⌘3 截图并保存。\nTopLet 会将截图收集到这里，方便多选后一起拖出。"
          }
        }
      }
    },
    "The helper tool ensures your charging rules are still applied even if the TopLet app isn't running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper tool ensures your charging rules are still applied even if the TopLet app isn't running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 TopLet 未运行，辅助工具也会确保充电规则继续生效。"
          }
        }
      }
    },
    "To enable Spotify integration, please add your API credentials in TopLet's settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To enable Spotify integration, please add your API credentials in TopLet's settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要启用 Spotify 集成，请先在 TopLet 设置中添加 API 凭据。"
          }
        }
      }
    },
    "To use Gemini Live, please add your Google AI Studio API key in TopLet's settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use Gemini Live, please add your Google AI Studio API key in TopLet's settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用 Gemini Live，请先在 TopLet 设置中添加 Google AI Studio API 密钥。"
          }
        }
      }
    },
    "Type a short trigger anywhere and it becomes your text. Use \"{{date}}\", \"{{time}}\", \"{{date:MMMM d}}\" or \"{{clipboard}}\" in the replacement. TopLet never expands while you type inside TopLet itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a short trigger anywhere and it becomes your text. Use \"{{date}}\", \"{{time}}\", \"{{date:MMMM d}}\" or \"{{clipboard}}\" in the replacement. TopLet never expands while you type inside TopLet itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置输入短触发词，即可展开为文本。替换内容支持 {{date}}、{{time}}、{{date:MMMM d}} 和 {{clipboard}}。在 TopLet 内输入时不会展开。"
          }
        }
      }
    },
    "Updates are installed from the About page in TopLet's settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are installed from the About page in TopLet's settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 TopLet 设置的“关于”页面安装更新。"
          }
        }
      }
    },
    "Uses its own signed updater — TopLet will open the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses its own signed updater — TopLet will open the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自身签名的更新器，TopLet 会打开该应用。"
          }
        }
      }
    },
    "Welcome to TopLet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to TopLet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 TopLet"
          }
        }
      }
    },
    "When TopLet opens a DMG, mount it, install contained apps, unmount, and clean up automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When TopLet opens a DMG, mount it, install contained apps, unmount, and clean up automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 TopLet 打开 DMG 时，自动挂载、安装其中应用、卸载磁盘并清理。"
          }
        }
      }
    },
    "When TopLet opens an archive, extract it automatically. Disable to hand archives back to macOS Archive Utility.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When TopLet opens an archive, extract it automatically. Disable to hand archives back to macOS Archive Utility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 TopLet 打开归档时自动解压。关闭后交由 macOS 归档实用工具处理。"
          }
        }
      }
    },
    "Your usual TopLet interface becomes available again after you unlock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your usual TopLet interface becomes available again after you unlock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁后可恢复使用通常的 TopLet 界面。"
          }
        }
      }
    },
    "Download and verify in the background. Restart when ready, or install when you next quit TopLet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and verify in the background. Restart when ready, or install when you next quit TopLet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台下载并验证。准备完成后可以立即重启，或在下次退出 TopLet 时安装。"
          }
        }
      }
    },
    "Restart now, or the prepared update will install when you quit TopLet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart now, or the prepared update will install when you quit TopLet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在重启，或在退出 TopLet 时安装已准备好的更新。"
          }
        }
      }
    },
    "TopLet %@ is available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet %@ is available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet %@ 已发布"
          }
        }
      }
    },
    "Check periodically while TopLet is running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check periodically while TopLet is running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TopLet 运行时定期检查新版。"
          }
        }
      }
    },
    "Drop files, images, links, or text onto TopLet’s AirDrop icon to choose a nearby device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files, images, links, or text onto TopLet’s AirDrop icon to choose a nearby device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件、图片、链接或文字拖到 TopLet 的隔空投送图标上，即可选择附近设备。"
          }
        }
      }
    },
    "TopLet AirDrop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet AirDrop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 隔空投送"
          }
        }
      }
    },
    "TopLet AirDrop — drop files, images, links, or text here": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet AirDrop — drop files, images, links, or text here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 隔空投送 — 将文件、图片、链接或文字拖到这里"
          }
        }
      }
    },
    "AirDrop in TopLet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop in TopLet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TopLet 内的隔空投送"
          }
        }
      }
    },
    "Open File Shelf → AirDrop in TopLet to drop items, choose files, or share your clipboard. You can also AirDrop selected screenshots from the Screenshots tab.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open File Shelf → AirDrop in TopLet to drop items, choose files, or share your clipboard. You can also AirDrop selected screenshots from the Screenshots tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TopLet 内打开“文件架 → AirDrop”，即可拖入内容、选择文件或分享剪贴板。也可以在“截图”标签多选截图后隔空投送。"
          }
        }
      }
    },
    "Allow TopLet in System Settings → Privacy & Security → Accessibility to move and resize windows. If it is already enabled after an update, remove the old entry and add the TopLet app you are currently using.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow TopLet in System Settings → Privacy & Security → Accessibility to move and resize windows. If it is already enabled after an update, remove the old entry and add the TopLet app you are currently using."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 → 隐私与安全性 → 辅助功能”中允许 TopLet 移动和调整窗口。如果更新后开关已经打开但仍无效，请移除旧条目，并重新添加当前使用的 TopLet 应用。"
          }
        }
      }
    },
    "Allow TopLet in System Settings → Privacy & Security → Device Control and Data Access to move and resize windows. If it is already enabled after an update, remove the old entry and add the TopLet app you are currently using.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow TopLet in System Settings → Privacy & Security → Device Control and Data Access to move and resize windows. If it is already enabled after an update, remove the old entry and add the TopLet app you are currently using."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 隐私与安全性 → 设备控制与数据访问中允许 TopLet 移动和调整窗口。如果更新后开关已开启但仍无效，请移除旧条目，并添加你当前使用的 TopLet 应用。"
          }
        }
      }
    },
    "Drag files or images to TopLet at the top of the screen, then release to choose your iPhone, iPad, or Mac in the system AirDrop window. Turn this off to show the usual file destinations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag files or images to TopLet at the top of the screen, then release to choose your iPhone, iPad, or Mac in the system AirDrop window. Turn this off to show the usual file destinations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件或图片拖到屏幕顶部的 TopLet，松手后在系统 AirDrop 窗口选择 iPhone、iPad 或 Mac。关闭此选项可恢复文件投放目标列表。"
          }
        }
      }
    },
