          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 macOS iPhone 镜像时，改为启动安卓屏幕镜像，适合没有 iPhone 的用户。仅在手机已连接时替换。"
          }
