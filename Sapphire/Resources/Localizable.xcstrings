          }
        }
      }
    },
    "Choose where each app's items go. Option-click the control item to arrange them in the menu bar instead; TopLet learns the new layout when you click it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where each app's items go. Option-click the control item to arrange them in the menu bar instead; TopLet learns the new layout when you click it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择各应用项目的归属区域。也可按住 Option 点击控制项目，在菜单栏中排列；再次点击后 TopLet 会记住新布局。"
          }
        }
      }
    },
    "Choose which system notifications TopLet mirrors or enhances.": {
      "extractionState": "manual",
